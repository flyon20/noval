# Copy this file to .env and replace every CHANGE_ME value before first start.

MYSQL_ROOT_PASSWORD=CHANGE_ME_WITH_A_STRONG_ROOT_PASSWORD
MYSQL_USER=novel
MYSQL_PASSWORD=CHANGE_ME_WITH_A_STRONG_APP_PASSWORD

APP_DOMAIN=www.panch.fun
ROOT_DOMAIN=panch.fun
NGINX_SSL_DIR=/etc/nginx/ssl
# Required files: panch-origin.crt, panch-origin.key, cloudflare-origin-pull-ca.pem.
# Production is fail-closed. A loopback-only Tunnel origin may opt out with the explicit tunnel-only flag.
NGINX_SSL_VERIFY_CLIENT=on
NOVAL_CLOUDFLARE_TUNNEL_ONLY=false

REDIS_PASSWORD=CHANGE_ME_WITH_A_STRONG_REDIS_PASSWORD
RABBITMQ_DEFAULT_USER=noval
RABBITMQ_DEFAULT_PASS=CHANGE_ME_WITH_A_STRONG_RABBITMQ_PASSWORD
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_MANAGEMENT_BIND_ADDRESS=127.0.0.1
RABBITMQ_MANAGEMENT_PORT=15672

# Host-published data ports stay on loopback unless explicitly bound to a trusted LAN IPv4.
# Never set this to 0.0.0.0. Qdrant currently has no API key in this deployment.
NOVAL_DATA_BIND_ADDRESS=127.0.0.1
MYSQL_LAN_PORT=3306
REDIS_LAN_PORT=6379
RABBITMQ_AMQP_LAN_PORT=5672
QDRANT_HTTP_LAN_PORT=6333

# J3160 8 GiB resource envelope. Raise concurrency only after load testing.
BACKEND_JAVA_TOOL_OPTIONS="-Xms256m -Xmx1024m -XX:+UseG1GC"
BACKEND_MEMORY_LIMIT=1536m
BACKEND_MEMORY_SWAP_LIMIT=1536m
CRAWLER_MEMORY_LIMIT=384m
CRAWLER_MEMORY_SWAP_LIMIT=384m
LANGGRAPH_MEMORY_LIMIT=768m
LANGGRAPH_MEMORY_SWAP_LIMIT=768m
FASTMCP_MEMORY_LIMIT=256m
FASTMCP_MEMORY_SWAP_LIMIT=256m
MYSQL_MEMORY_LIMIT=1280m
MYSQL_MEMORY_SWAP_LIMIT=1280m
MYSQL_CPU_LIMIT=0.50
MYSQL_MALLOC_ARENA_MAX=4
MYSQL_PERFORMANCE_SCHEMA_DIGESTS_SIZE=2000
MYSQL_PERFORMANCE_SCHEMA_HISTORY_LONG_SIZE=1000
QDRANT_MEMORY_LIMIT=640m
QDRANT_MEMORY_SWAP_LIMIT=640m

JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
CONFIG_SECRET_MASTER_KEY=CHANGE_ME_WITH_ANOTHER_RANDOM_SECRET
CRAWLER_INTERNAL_API_KEY=CHANGE_ME_WITH_A_RANDOM_INTERNAL_API_KEY
AI_LANGGRAPH_WORKER_INTERNAL_API_KEY=CHANGE_ME_WITH_A_RANDOM_LANGGRAPH_INTERNAL_KEY
# Each MCP secret below must contain at least 32 characters.
FASTMCP_INTERNAL_API_KEY=CHANGE_ME_WITH_A_RANDOM_FASTMCP_INTERNAL_KEY_AT_LEAST_32_CHARS
MCP_CALL_SIGNING_KEY=CHANGE_ME_WITH_A_RANDOM_MCP_CALL_SIGNING_KEY_AT_LEAST_32_CHARS
MCP_BACKEND_ATTESTATION_KEY=CHANGE_ME_WITH_A_RANDOM_MCP_BACKEND_ATTESTATION_KEY_AT_LEAST_32_CHARS
MCP_NONCE_REDIS_DB=3
MCP_NONCE_MAX_ENTRIES=10000

CLOUDFLARE_TURNSTILE_ENABLED=true
CLOUDFLARE_TURNSTILE_SITE_KEY=CHANGE_ME_WITH_TURNSTILE_SITE_KEY
CLOUDFLARE_TURNSTILE_SECRET_KEY=CHANGE_ME_WITH_TURNSTILE_SECRET_KEY
CLOUDFLARE_TURNSTILE_EXPECT_HOSTNAME=www.panch.fun

# Default OpenAI-compatible model runtime.
AI_OPENAI_COMPATIBLE_API_KEY_REF=DEEPSEEK_API_KEY
AI_OPENAI_COMPATIBLE_DEFAULT_MODEL=deepseek-v4-flash
AI_OPENAI_COMPATIBLE_DEEP_MODEL=deepseek-v4-pro
AI_OPENAI_COMPATIBLE_INTENT_MODEL=deepseek-v4-flash
AI_OPENAI_COMPATIBLE_REVIEW_MODEL=deepseek-v4-flash
AI_OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
AI_OPENAI_COMPATIBLE_WIRE_API=responses
AI_OPENAI_COMPATIBLE_RESPONSES_BASE_URL=https://api.deepseek.com
AI_OPENAI_COMPATIBLE_RESPONSES_MODELS=deepseek-v4-flash,deepseek-v4-pro
AI_OPENAI_COMPATIBLE_PROMPT_CACHE_KEY_MODELS=gpt-*
AI_OPENAI_COMPATIBLE_PROVIDER_USER_MODELS=deepseek-*
AI_MODEL_CONTEXT_CAPABILITIES_JSON=
AI_CONTEXT_COMPACTION_ENABLED=true
AI_OPENAI_COMPATIBLE_RESPONSES_CHAT_FALLBACK_ENABLED=true
DEEPSEEK_API_KEY=

# Optional Dify fallback.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY_REF=DIFY_API_KEY
DIFY_API_KEY=

# Internal LangGraph worker.
AI_LANGGRAPH_WORKER_BASE_URL=http://langgraph-worker:8001
AI_LANGGRAPH_WORKER_TIMEOUT_MILLIS=30000
AI_CACHE_CONTINUITY_ENABLED=true
AI_BACKEND_TOOL_TIMEOUT_MILLIS=90000
AI_LANGGRAPH_CHECKPOINT_BACKEND=mysql
AI_MCP_BASE_URL=http://fastmcp-tools:7001
AI_MCP_TIMEOUT_MILLIS=30000
AI_AGENT_LATEST_RANK_MAX_AGE_DAYS=3
AI_AGENT_MARKET_TOPN_DEFAULT=30
AI_AGENT_MAX_SKILL_CHARS=0
AGENT_MODEL_FIRST_INTENT_ENABLED=true
AGENT_DOMAIN_MODEL_SPECIALISTS_ENABLED=true
AGENT_ANSWER_REVIEW_ENABLED=true
AGENT_ANSWER_REVISION_ENABLED=true

# Knowledge indexing and retrieval.
KNOWLEDGE_QDRANT_BASE_URL=http://qdrant:6333
KNOWLEDGE_QDRANT_COLLECTION=novel_knowledge_chunks
KNOWLEDGE_QDRANT_MEMORY_COLLECTION=noval_ai_memory
# Use dashscope for OpenAI-compatible text embeddings.
# Use dashscope-multimodal for Tongyi multimodal embedding HTTP API.
KNOWLEDGE_EMBEDDING_PROVIDER=dashscope
KNOWLEDGE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v4
KNOWLEDGE_EMBEDDING_DIMENSION=1024
KNOWLEDGE_EMBEDDING_API_KEY_REF=DASHSCOPE_API_KEY
KNOWLEDGE_EMBEDDING_API_KEY=
DASHSCOPE_API_KEY=
KNOWLEDGE_INDEX_MAX_CHAPTERS=10
KNOWLEDGE_INDEX_MAX_ACTIVE_JOBS=1
KNOWLEDGE_INDEX_CHUNK_TARGET_CHARS=1000
KNOWLEDGE_INDEX_CHUNK_OVERLAP_CHARS=160
KNOWLEDGE_INDEX_QUEUE_ENABLED=true
KNOWLEDGE_CHAT_RUN_QUEUE_ENABLED=true
KNOWLEDGE_CHAT_RUN_OUTBOX_DISPATCH_INTERVAL_MILLIS=1000
KNOWLEDGE_CHAT_RUN_OUTBOX_RECOVERY_INTERVAL_MILLIS=30000
KNOWLEDGE_CHAT_RUN_OUTBOX_RECOVERY_INITIAL_DELAY_MILLIS=30000
KNOWLEDGE_CHAT_RUN_WORKER_CONCURRENCY=1
KNOWLEDGE_CHAT_RUN_LEASE_SECONDS=45
KNOWLEDGE_CHAT_RUN_HEARTBEAT_SECONDS=10
KNOWLEDGE_INDEX_WORKER_CONCURRENCY=1
KNOWLEDGE_INDEX_MAX_RETRIES=3
KNOWLEDGE_INDEX_VISIBILITY_TIMEOUT_SECONDS=600
KNOWLEDGE_INDEX_RETRY_BACKOFF_SECONDS=30,120,600
KNOWLEDGE_INDEX_RABBIT_EXCHANGE=noval.knowledge.index
KNOWLEDGE_INDEX_RABBIT_QUEUE=noval.knowledge.index.book
KNOWLEDGE_INDEX_RABBIT_ROUTING_KEY=knowledge.index.book
KNOWLEDGE_INDEX_RABBIT_RETRY_EXCHANGE=noval.knowledge.index.retry
KNOWLEDGE_INDEX_RABBIT_RETRY_ROUTING_KEY_PREFIX=knowledge.index.book.retry
KNOWLEDGE_INDEX_RABBIT_DEAD_LETTER_EXCHANGE=noval.knowledge.index.dlx
KNOWLEDGE_INDEX_RABBIT_DEAD_LETTER_QUEUE=noval.knowledge.index.book.dlq
KNOWLEDGE_INDEX_RABBIT_DEAD_LETTER_ROUTING_KEY=knowledge.index.book.dlq
KNOWLEDGE_RANK_INCREMENTAL_ENABLED=true
KNOWLEDGE_RANK_INCREMENTAL_CRON="0 20 3 * * ?"
KNOWLEDGE_RANK_INCREMENTAL_LIMIT=500
KNOWLEDGE_CHAPTER_MISSING_ENABLED=false
KNOWLEDGE_CHAPTER_MISSING_CRON="0 50 3 * * ?"
KNOWLEDGE_CHAPTER_MISSING_LIMIT=100

# Shared J3160 8GB resource policy used by Backend, Worker, crawler and later admission controls.
NOVAL_RESOURCE_MAX_ACTIVE_DEEP_RUNS=1
NOVAL_RESOURCE_MAX_ACTIVE_FAST_RUNS=2
NOVAL_RESOURCE_MAX_ACTIVE_LLM_CALLS=2
NOVAL_RESOURCE_MAX_DELEGATED_AGENT_CONCURRENCY=1
NOVAL_RESOURCE_MAX_INDEX_CONCURRENCY=1
NOVAL_RESOURCE_MAX_CRAWLER_CONCURRENCY=2
NOVAL_RESOURCE_MEMORY_PAUSE_PERCENT=85
NOVAL_RESOURCE_MEMORY_REJECT_DEEP_PERCENT=92
NOVAL_RESOURCE_DISK_WARN_PERCENT=80
NOVAL_RESOURCE_DISK_STOP_IMPORT_PERCENT=90
NOVAL_RESOURCE_QUEUE_BACKLOG_WARN_COUNT=20
NOVAL_RESOURCE_QUEUE_OLDEST_WARN_MINUTES=5

# SMS provider.
ALIYUN_DYPNS_ENABLED=false
ALIYUN_DYPNS_ACCESS_KEY_ID=
ALIYUN_DYPNS_ACCESS_KEY_SECRET=
ALIYUN_DYPNS_SIGN_NAME=
ALIYUN_DYPNS_TEMPLATE_CODE_REGISTER=
ALIYUN_DYPNS_TEMPLATE_CODE_LOGIN=
ALIYUN_DYPNS_TEMPLATE_CODE_RESET_PASSWORD=
ALIYUN_DYPNS_SCHEME_NAME=noval-web
ALIYUN_DYPNS_COUNTRY_CODE=86
ALIYUN_DYPNS_VALID_TIME_MINUTES=5
ALIYUN_DYPNS_INTERVAL_SECONDS=60

# Password login risk control.
SECURITY_PASSWORD_LOGIN_PHONE_WINDOW_SECONDS=600
SECURITY_PASSWORD_LOGIN_PHONE_MAX_FAILURES=6
SECURITY_PASSWORD_LOGIN_IP_WINDOW_SECONDS=600
SECURITY_PASSWORD_LOGIN_IP_MAX_FAILURES=20
SECURITY_PASSWORD_LOGIN_PHONE_IP_WINDOW_SECONDS=600
SECURITY_PASSWORD_LOGIN_PHONE_IP_MAX_FAILURES=4
SECURITY_PASSWORD_LOGIN_COOLDOWN_SECONDS=900

KNOWLEDGE_PROJECT_INGEST_QUEUE_ENABLED=true
KNOWLEDGE_PROJECT_INGEST_WORKER_CONCURRENCY=1
KNOWLEDGE_PROJECT_INGEST_LEASE_SECONDS=60
KNOWLEDGE_PROJECT_INGEST_HEARTBEAT_SECONDS=15
KNOWLEDGE_PROJECT_INGEST_MAX_ATTEMPTS=3
KNOWLEDGE_PROJECT_INGEST_MAX_CHAPTER_CHARS=100000
KNOWLEDGE_PROJECT_INGEST_MAX_FILE_BYTES=20971520
KNOWLEDGE_PROJECT_INGEST_MAX_CHAPTERS_PER_PROJECT=5000
KNOWLEDGE_PROJECT_INGEST_MAX_CONCURRENT_JOBS_PER_USER=1
KNOWLEDGE_PROJECT_INGEST_PARSER_VERSION=project-ingest-v1
KNOWLEDGE_PROJECT_INGEST_RETRY_BACKOFF_SECONDS=30,120,600
KNOWLEDGE_PROJECT_INGEST_RABBIT_EXCHANGE=noval.knowledge.project-ingest
KNOWLEDGE_PROJECT_INGEST_RABBIT_QUEUE=noval.knowledge.project-ingest.job
KNOWLEDGE_PROJECT_INGEST_RABBIT_ROUTING_KEY=knowledge.project-ingest.job
KNOWLEDGE_PROJECT_INGEST_RABBIT_DEAD_LETTER_EXCHANGE=noval.knowledge.project-ingest.dlx
KNOWLEDGE_PROJECT_INGEST_RABBIT_DEAD_LETTER_QUEUE=noval.knowledge.project-ingest.job.dlq
KNOWLEDGE_PROJECT_INGEST_RABBIT_DEAD_LETTER_ROUTING_KEY=knowledge.project-ingest.job.dlq
PROJECT_DOCUMENT_MAX_FILE_SIZE=20MB
PROJECT_DOCUMENT_MAX_REQUEST_SIZE=100MB
KNOWLEDGE_DOCUMENT_BATCH_QUEUE_ENABLED=true
KNOWLEDGE_DOCUMENT_BATCH_WORKER_CONCURRENCY=1
KNOWLEDGE_DOCUMENT_BATCH_LEASE_SECONDS=300
KNOWLEDGE_DOCUMENT_BATCH_MAX_ATTEMPTS=4
KNOWLEDGE_DOCUMENT_BATCH_MAX_FILES=200
KNOWLEDGE_DOCUMENT_BATCH_MAX_BYTES=94371840
KNOWLEDGE_DOCUMENT_BATCH_MAX_ZIP_ENTRIES=1000
KNOWLEDGE_DOCUMENT_BATCH_MAX_EXPANDED_BYTES=209715200
KNOWLEDGE_DOCUMENT_INDEX_BATCH_SIZE=32
KNOWLEDGE_DOCUMENT_CHAPTER_DISPATCH_WINDOW=8
